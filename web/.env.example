# Origin of the BFF. Leave empty for same-origin (the BFF serves the app, or the dev proxy forwards /api).
VITE_API_BASE_URL=
# Hard timeout per API request, in milliseconds. Keep it above the BFF's upstream budget (10 s).
VITE_REQUEST_TIMEOUT_MS=15000
# Where the Vite dev/preview proxy forwards /api (the BFF, see api/README). Never shipped to the browser.
API_PROXY_TARGET=http://localhost:5080
