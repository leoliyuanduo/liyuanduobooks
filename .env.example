# Base path the browser calls. Keep it same-origin; the dev server / hosting layer proxies it.
VITE_API_BASE_URL=/api
# Hard timeout per API request, in milliseconds.
VITE_REQUEST_TIMEOUT_MS=8000
# Upstream used by the Vite dev/preview proxy only (never shipped to the browser).
API_PROXY_TARGET=https://digitalcodingtest.bupa.com.au
