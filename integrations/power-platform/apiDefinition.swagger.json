{
  "swagger": "2.0",
  "info": {
    "title": "Owners and Books",
    "description": "Books from the Bupa coding-test data, grouped by the age category of their owner (adults 18+, children 17 and under), optionally filtered by format and always in alphabetical order. Business rules run in the BFF; this connector only states intent.",
    "version": "1.0"
  },
  "host": "REPLACE-WITH-APP-HOST.australiaeast.azurecontainerapps.io",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/books": {
      "get": {
        "operationId": "GetBooks",
        "summary": "List books owned by an age category",
        "description": "Returns books owned by adults (18+) or children (17 and under), optionally only one format, sorted alphabetically by title.",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "ageCategory",
            "in": "query",
            "required": true,
            "type": "string",
            "enum": [
              "adult",
              "child"
            ],
            "x-ms-summary": "Age category",
            "description": "Owners aged 18 and over (adult) or 17 and under (child)."
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "type": "string",
            "enum": [
              "hardcover",
              "paperback",
              "ebook"
            ],
            "x-ms-summary": "Book format",
            "description": "Only return books in this format. Leave empty for all formats."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "x-ms-summary": "Page size",
            "description": "How many books to return per page (1 to 100).",
            "x-ms-visibility": "advanced"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "Next page cursor",
            "description": "Pass page.nextCursor from the previous response to get the next page.",
            "x-ms-visibility": "advanced"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of books.",
            "schema": {
              "$ref": "#/definitions/BooksPage"
            }
          },
          "400": {
            "description": "A parameter is outside the contract.",
            "schema": {
              "$ref": "#/definitions/ProblemDetails"
            }
          },
          "429": {
            "description": "Too many requests; retry after the Retry-After header.",
            "schema": {
              "$ref": "#/definitions/ProblemDetails"
            }
          },
          "502": {
            "description": "The upstream book service returned an error or invalid data.",
            "schema": {
              "$ref": "#/definitions/ProblemDetails"
            }
          },
          "503": {
            "description": "Temporarily unavailable; retry after the Retry-After header.",
            "schema": {
              "$ref": "#/definitions/ProblemDetails"
            }
          },
          "504": {
            "description": "The upstream book service timed out.",
            "schema": {
              "$ref": "#/definitions/ProblemDetails"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Book": {
      "type": "object",
      "required": [
        "id",
        "title",
        "format"
      ],
      "properties": {
        "id": {
          "type": "string",
          "x-ms-summary": "Book ID",
          "description": "Opaque identifier of this owned copy."
        },
        "title": {
          "type": "string",
          "x-ms-summary": "Title"
        },
        "format": {
          "type": "string",
          "enum": [
            "hardcover",
            "paperback",
            "ebook",
            "other"
          ],
          "x-ms-summary": "Format"
        }
      }
    },
    "PageInfo": {
      "type": "object",
      "required": [
        "limit",
        "nextCursor",
        "totalCount"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "format": "int32",
          "x-ms-summary": "Page size"
        },
        "nextCursor": {
          "type": "string",
          "x-nullable": true,
          "x-ms-summary": "Next page cursor",
          "description": "Null on the last page."
        },
        "totalCount": {
          "type": "integer",
          "format": "int32",
          "x-ms-summary": "Total books"
        }
      }
    },
    "BooksPage": {
      "type": "object",
      "required": [
        "items",
        "page"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Book"
          },
          "x-ms-summary": "Books"
        },
        "page": {
          "$ref": "#/definitions/PageInfo"
        }
      }
    },
    "ProblemDetails": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "format": "int32"
        },
        "detail": {
          "type": "string"
        },
        "traceId": {
          "type": "string",
          "x-ms-summary": "Trace ID"
        }
      }
    }
  },
  "securityDefinitions": {},
  "security": [],
  "tags": [],
  "x-ms-connector-metadata": [
    {
      "propertyName": "Website",
      "propertyValue": "https://github.com/"
    },
    {
      "propertyName": "Categories",
      "propertyValue": "Data"
    }
  ]
}
