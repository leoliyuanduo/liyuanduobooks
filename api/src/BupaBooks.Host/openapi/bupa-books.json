{
  "openapi": "3.1.1",
  "info": {
    "title": "Bupa Books BFF",
    "description": "Backend for the Owners and Books app. Applies the business rules (age categories, format filter, alphabetical order) to data from the Bupa coding-test API.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/books": {
      "get": {
        "tags": [
          "Books"
        ],
        "summary": "List books owned by an age category",
        "description": "Returns books owned by adults (18+) or children (17 and under), optionally filtered by format, sorted alphabetically by title (case-insensitive, then by id). Supports cursor paging and ETags.",
        "operationId": "GetBooks",
        "parameters": [
          {
            "name": "ageCategory",
            "in": "query",
            "description": "Age category of the owners: adult (18 and over) or child (17 and under).",
            "required": true,
            "schema": {
              "enum": [
                "adult",
                "child"
              ],
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Only return books in this format. Omit for all formats.",
            "schema": {
              "enum": [
                "hardcover",
                "paperback",
                "ebook"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size. Default 50.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from page.nextCursor of the previous response.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BooksPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BookFormatContract": {
        "enum": [
          "hardcover",
          "paperback",
          "ebook",
          "other"
        ]
      },
      "BookResponse": {
        "required": [
          "id",
          "title",
          "format"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "format": {
            "$ref": "#/components/schemas/BookFormatContract"
          }
        }
      },
      "BooksPageResponse": {
        "required": [
          "items",
          "page"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookResponse"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "PageInfo": {
        "required": [
          "limit",
          "nextCursor",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Books"
    }
  ]
}